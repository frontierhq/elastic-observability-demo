{
  "index_patterns": [
    "logs-rancher*-*"
  ],
  "composed_of": [
    "frontier-ecs-base@9.2.0",
    "frontier-ecs-data_stream@9.2.0",
    "frontier-ecs-ecs@9.2.0",
    "ecs@mappings"
  ],
  "priority": 300,
  "data_stream": {
    "hidden": false,
    "allow_custom_routing": false
  },
  "template": {
    "mappings": {
      "date_detection": false
    },
    "settings": {
      "index": {
        "codec": "best_compression",
        "lifecycle": {
          "name": "frontier-logs"
        },
        "default_pipeline": "frontier-logs-rancher@default",
        "final_pipeline": "frontier-logs@final"
      }
    }
  }
}
